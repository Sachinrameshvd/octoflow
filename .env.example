# ==============================================================================
# OctoFlow Environment Configuration Template (.env.example)
# Copy to '.env' and fill in the values appropriate for your environment.
# Never commit real credentials or production secrets to version control.
# ==============================================================================

# --- LLM Provider API Credentials ---
# Required only if using live cloud models. Leave blank for local 'mock' or 'ollama'.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
XAI_API_KEY=your-xai-grok-api-key-here

# --- Default Execution & Provider Routing ---
# Provider options: mock (offline/deterministic), anthropic, openai, gemini, grok, deepseek, ollama
OCTOFLOW_MODEL_PROVIDER=mock
OCTOFLOW_MODEL_NAME=claude-3-5-sonnet-20241022

# --- Heterogeneous Routing (Optional) ---
# Route complex reasoning to frontier models, fast execution to lightweight models
OCTOFLOW_FRONTIER_PROVIDER=anthropic
OCTOFLOW_FRONTIER_MODEL=claude-3-7-sonnet-20250219
OCTOFLOW_FAST_PROVIDER=openai
OCTOFLOW_FAST_MODEL=gpt-4o-mini

# --- Ollama / Local LLM Endpoint ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Workspace & Sandbox Security ---
# Sandbox mode: 'local' (host workspace) or 'docker' (isolated ephemeral container)
OCTOFLOW_SANDBOX_MODE=local
OCTOFLOW_DOCKER_IMAGE=python:3.12-slim
OCTOFLOW_MAX_BUDGET_DOLLARS=5.00
OCTOFLOW_MAX_STEPS_PER_ARM=15
OCTOFLOW_SURPRISE_THRESHOLD=0.50

# --- Telemetry & WebSocket Visualizer ---
OCTOFLOW_ENABLE_3D_TELEMETRY=true
OCTOFLOW_TELEMETRY_PORT=8088

# --- Alerts & Notifications ---
# Webhook URL for mission completion and surprise escalation events (Slack/Discord)
OCTOFLOW_WEBHOOK_URL=

# --- REST API & Cockpit Authentication ---
# Secret key used for signing JWT tokens in API cockpit mode
OCTOFLOW_JWT_SECRET=generate-a-secure-random-secret-key-min-32-chars
OCTOFLOW_API_PORT=8000
OCTOFLOW_API_DEBUG=false
